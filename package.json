{
  "name": "@pixagram/dpixa",
  "version": "1.6.0",
  "description": "Pixa blockchain RPC client library",
  "author": "pixa-blockchain",
  "license": "BSD-3-Clause-No-Military-License",
  "main": "./lib/index-node.js",
  "types": "./lib/index.d.ts",
  "browser": {
    "./lib/index-node": "./dist/dpixa.js",
    "./lib/index-node.js": "./dist/dpixa.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": "./lib/index-node.js",
      "browser": "./esm/index.mjs",
      "module": "./esm/index.mjs",
      "import": "./esm/index.mjs",
      "default": "./lib/index-node.js"
    },
    "./lite": {
      "types": "./lib/index-lite.d.ts",
      "node": "./lib/index-lite.js",
      "browser": "./esm/lite.mjs",
      "module": "./esm/lite.mjs",
      "import": "./esm/lite.mjs",
      "default": "./lib/index-lite.js"
    },
    "./crypto": {
      "types": "./lib/index-crypto.d.ts",
      "node": "./lib/index-crypto.js",
      "browser": "./esm/crypto.mjs",
      "module": "./esm/crypto.mjs",
      "import": "./esm/crypto.mjs",
      "default": "./lib/index-crypto.js"
    },
    "./dist/dpixa": "./dist/dpixa.js",
    "./dist/dpixa-lite": "./dist/dpixa-lite.js",
    "./dist/*": "./dist/*",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lite": [
        "./lib/index-lite.d.ts"
      ],
      "crypto": [
        "./lib/index-crypto.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "esm",
    "lib"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pixagram-blockchain/dpixa"
  },
  "scripts": {
    "build": "make build",
    "lint": "make lint",
    "test": "make ci-test",
    "test:unit": "make test-unit",
    "prepublishOnly": "make all"
  },
  "keywords": [
    "blockchain",
    "client",
    "rpc",
    "pixa",
    "dpixa",
    "pixagram",
    "crypto",
    "api",
    "sdk"
  ],
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^5.2.5",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "coveralls": "^3.0.11",
    "dts-generator": "^2.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-prefer-arrow": "^1.1.7",
    "lorem-ipsum": "^1.0.6",
    "mocha": "^7.1.1",
    "nyc": "^15.0.0",
    "ts-node": "^8.7.0",
    "tslint": "^5.11.0",
    "typedoc": "~0.28.15",
    "typedoc-material-theme": "^1.4.1",
    "typedoc-plugin-md": "~0.7.1",
    "typescript": "~5.9.3"
  }
}
